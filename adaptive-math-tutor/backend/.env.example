# AdaptMath backend example environment configuration.
# Copy to .env and replace placeholders locally. Never commit real secrets.

APP_NAME=AdaptMath API
APP_ENV=development
LOG_LEVEL=INFO

# Teammate-owned service URLs. Replace with the real integration endpoints.
PROFILE_API_URL=http://127.0.0.1:8101
MEMORY_API_URL=http://127.0.0.1:8400
MEMORY_ENABLED=true
MEMORY_SERVICE_API_KEY=replace-with-the-same-server-side-memory-service-key
MEMORY_TIMEOUT_SECONDS=2.0
MEMORY_TOPIC_TIMEOUT_SECONDS=15.0
MEMORY_HISTORY_LIMIT=5
STRATEGY_API_URL=http://127.0.0.1:8103

# Model provider. The backend also loads GEMINI_API_KEY from the workspace-level
# student-modeling/.env so Tutor and Student Modeling use one credential.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=0
PLANNING_COMPLEXITY_THRESHOLD=0.5

# Local persistent LangGraph checkpoint database
CHECKPOINT_DB_PATH=runtime/adaptmath_checkpoints.sqlite3
TUTOR_PERSISTENCE=sqlite
# Shared PostgreSQL URL used when TUTOR_PERSISTENCE=postgres.
ADAPTMATH_DATABASE_URL=postgresql://memory_app:change-me@127.0.0.1:5433/adaptmath_memory_integration
TUTOR_PERSISTENCE_SCHEMA=tutor
STUDENT_MODEL_PERSISTENCE=postgres
STUDENT_MODEL_DATABASE_SCHEMA=student_model
RESEARCH_PERSISTENCE=postgres
RESEARCH_DATABASE_SCHEMA=research
AUTH_DATABASE_SCHEMA=auth

# Explicit browser origins only; wildcard '*' is intentionally unsupported.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true
