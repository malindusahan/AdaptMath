# =====================================================================
# Student Personalization Memory Subsystem - Configuration
# =====================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Dedicated local/research PostgreSQL target (psycopg 3)
MEMORY_DATABASE_URL=postgresql+psycopg://memory_app:change-me@127.0.0.1:5433/adaptmath_memory_integration
MEMORY_DATABASE_SCHEMA=student_memory

# Security & Authentication
MEMORY_AUTH_ENABLED=true
MEMORY_SERVICE_API_KEY=replace-with-a-random-service-secret
JWT_SECRET_KEY=replace-with-a-secure-secret-key-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
